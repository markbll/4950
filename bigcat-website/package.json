{
  "name": "bigcat-marketing-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Big Cat Marketing — local marketing website for Melbourne small business (prerendered React + PHP API).",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "php -S 127.0.0.1:8000 api/dev-router.php",
    "build": "npm run build:client && npm run build:ssr && npm run prerender && npm run sitemap && npm run htaccess && npm run verify",
    "build:client": "tsc --noEmit && vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "sitemap": "node scripts/sitemap.mjs",
    "verify": "node scripts/verify-dist.mjs",
    "preview": "node scripts/preview.mjs",
    "lint": "eslint . && tsc --noEmit",
    "test": "vitest run && npm run test:php",
    "test:php": "php api/tests/run.php",
    "test:watch": "vitest",
    "docs:generate": "node scripts/generate-docs.mjs",
    "check:facts": "node scripts/check-facts.mjs",
    "uat": "node scripts/uat.mjs",
    "htaccess": "node scripts/htaccess.mjs",
    "deploy:staging": "bash scripts/deploy-ftp.sh staging",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.56.1",
    "typescript": "5.9",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
