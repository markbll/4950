# =============================================================================
# Big Cat Marketing — environment variables (EXAMPLE ONLY — no real values here)
#
# Frontend (VITE_*) values are compiled into public HTML/JS at build time.
# NEVER put a secret in a VITE_* variable.
#
# API (PHP) values are secrets. Set them in the PHP-FPM pool / hosting panel,
# or in an env file OUTSIDE the web root pointed to by BIGCAT_ENV_FILE
# (see deploy/nginx/bigcat-site.conf). Never commit a real .env.
#
# SECURITY: the FTP credential previously shared for this project is
# compromised. Rotate it (and prefer SFTP/SSH keys) before any production deploy.
# =============================================================================

# ---------- Frontend build (npm run build) ----------
# Canonical origin used for canonicals, sitemap, Open Graph and JSON-LD.
VITE_SITE_URL=https://bigcatmarketing.com.au
# development | staging | production
#   staging/development => noindex meta, robots.txt Disallow: /, visible TODO markers
#   production          => indexable; build FAILS while required business facts are TODO
VITE_SITE_ENV=staging
# GA4 measurement ID (public, e.g. G-XXXXXXXXXX). Leave empty to disable GA; events still go to window.dataLayer.
VITE_GA_MEASUREMENT_ID=

# ---------- PHP API (secrets — server only) ----------
# production | staging | development  (log mail transport is refused in production)
APP_ENV=staging
# Random string, at least 32 characters. Generate with: openssl rand -hex 32
APP_SECRET=
# Comma-separated origins allowed to POST to the API (CSRF check). No trailing slash.
ALLOWED_ORIGINS=https://ai-website.bigcatmarketing.com.au
# Writable directory OUTSIDE the web root (rate-limit data; purged after 24h).
STORAGE_DIR=/var/www/bigcat/staging/private/storage

# Mail: smtp (recommended) | mail (PHP mail()) | log (dev/UAT only: writes .eml files to STORAGE_DIR/mail-log)
MAIL_TRANSPORT=smtp
# Where leads are sent (the team inbox)
MAIL_TO=
# Sender address on your domain (SPF/DKIM must authorise the SMTP host)
MAIL_FROM=
MAIL_FROM_NAME=Big Cat Marketing Website
SMTP_HOST=
SMTP_PORT=587
# tls (STARTTLS, port 587) | ssl (implicit TLS, port 465)
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=

# Fetch the prospect's website for the check-up (1 = on, 0 = off → "Reviewed by our team")
CHECKUP_FETCH_ENABLED=1
# Only if behind a trusted reverse proxy/CDN that sets a client-IP header, e.g. HTTP_CF_CONNECTING_IP. Otherwise leave empty.
TRUSTED_PROXY_HEADER=
# UAT only: multiplies rate limits in non-production so automated tests can run. Ignored in production.
RATE_LIMIT_SCALE=1

# ---------- Local development ----------
# Where `npm run dev` / `npm run preview` proxy /api (started with `npm run dev:api`)
DEV_API_PROXY=http://127.0.0.1:8000
